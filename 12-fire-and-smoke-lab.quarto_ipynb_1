      "source": [
        "## Pull a daily PM2.5 time series\n",
        "\n",
        "For a first pass, daily aggregates are enough to reveal seasonality and smoke\n",
        "episodes without drowning in detail."
      ],
      "id": "f4d61f01"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| label: fig-smoke-timeseries\n",
        "#| fig-cap: Daily PM2.5 for a chosen Alberta station, with smoke episodes detected as runs above a threshold (default 25 µg/m³). The goal is not the perfect threshold; the goal is to make the event structure explicit so evaluation can be honest.\n",
        "\n",
        "SMOKE_THRESHOLD = 25.0  # µg/m³ (adjust for your policy/health framing)\n",
        "WINDOW_DAYS = 365\n",
        "\n",
        "\n",
        "def pick_location(locations_df: pd.DataFrame) -> pd.Series:\n",
        "    # Prefer Calgary or Edmonton if present; otherwise pick the first row.\n",
        "    for target in [\"Calgary\", \"Edmonton\"]:\n",
        "        hit = locations_df[locations_df[\"locality\"].fillna(\"\").str.contains(target, case=False)]\n",
        "        if len(hit) > 0:\n",
        "            return hit.iloc[0]\n",
        "    return locations_df.iloc[0]\n",
        "\n",
        "\n",
        "def fetch_pm25_sensor_id(location_id: int) -> int:\n",
        "    payload = openaq_get(f\"/locations/{location_id}/sensors\")\n",
        "    sensors = payload.get(\"results\", [])\n",
        "    for s in sensors:\n",
        "        p = s.get(\"parameter\") or {}\n",
        "        if p.get(\"id\") == PM25_PARAMETER_ID or p.get(\"name\") == \"pm25\":\n",
        "            return int(s[\"id\"])\n",
        "    raise RuntimeError(\"No PM2.5 sensor found for this location.\")\n",
        "\n",
        "\n",
        "def fetch_daily_pm25(sensor_id: int, days: int = WINDOW_DAYS) -> pd.DataFrame:\n",
        "    date_to = dt.datetime.now(dt.timezone.utc)\n",
        "    date_from = date_to - dt.timedelta(days=days)\n",
        "    payload = openaq_get(\n",
        "        f\"/sensors/{sensor_id}/days\",\n",
        "        params={\n",
        "            \"date_from\": date_from.isoformat(),\n",
        "            \"date_to\": date_to.isoformat(),\n",
        "            \"limit\": 1000,\n",
        "            \"page\": 1,\n",
        "        },\n",
        "    )\n",
        "    rows = []\n",
        "    for r in payload.get(\"results\", []):\n",
        "        dfrom = (r.get(\"datetimeFrom\") or {}).get(\"local\") or (r.get(\"datetimeFrom\") or {}).get(\"utc\")\n",
        "        val = r.get(\"value\")\n",
        "        cov = r.get(\"coverage\") or {}\n",
        "        rows.append(\n",
        "            {\n",
        "                \"date\": pd.to_datetime(dfrom).date() if dfrom else None,\n",
        "                \"pm25\": val,\n",
        "                \"percent_complete\": cov.get(\"percentComplete\"),\n",
        "            }\n",
        "        )\n",
        "    df = pd.DataFrame(rows).dropna(subset=[\"date\"])\n",
        "    df = df.sort_values(\"date\").reset_index(drop=True)\n",
        "    df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
        "    return df\n",
        "\n",
        "\n",
        "def synthetic_pm25_series(days: int = WINDOW_DAYS) -> pd.DataFrame:\n",
        "    rng = np.random.default_rng(2)\n",
        "    dates = pd.date_range(end=pd.Timestamp.today().normalize(), periods=days, freq=\"D\")\n",
        "    day_of_year = dates.dayofyear.to_numpy()\n",
        "    baseline = 6 + 3 * np.sin(2 * np.pi * (day_of_year / 365.25))\n",
        "    noise = rng.normal(0, 2.0, size=len(dates))\n",
        "    pm25 = np.clip(baseline + noise, 0, None)\n",
        "\n",
        "    # Add a couple of smoke episodes.\n",
        "    for start, length, peak in [(120, 10, 65), (250, 14, 45)]:\n",
        "        idx = np.arange(start, min(start + length, len(dates)))\n",
        "        pm25[idx] += peak * np.exp(-0.2 * (idx - start))\n",
        "\n",
        "    return pd.DataFrame({\"date\": dates, \"pm25\": pm25, \"percent_complete\": 100.0})\n",
        "\n",
        "\n",
        "loc = pick_location(locations)\n",
        "station_name = str(loc.get(\"name\") or loc.get(\"locality\") or \"Station\")\n",
        "\n",
        "try:\n",
        "    if int(loc[\"location_id\"]) < 0:\n",
        "        series = synthetic_pm25_series()\n",
        "        series_source = \"synthetic fallback\"\n",
        "    else:\n",
        "        sensor_id = fetch_pm25_sensor_id(int(loc[\"location_id\"]))\n",
        "        series = fetch_daily_pm25(sensor_id)\n",
        "        series_source = \"OpenAQ daily aggregates\"\n",
        "except Exception:\n",
        "    series = synthetic_pm25_series()\n",
        "    series_source = \"synthetic fallback\"\n",
        "\n",
        "series = series.dropna(subset=[\"pm25\"]).copy()\n",
        "series[\"is_smoke\"] = series[\"pm25\"] >= SMOKE_THRESHOLD\n",
        "\n",
        "# Detect runs above threshold.\n",
        "series[\"episode_id\"] = (series[\"is_smoke\"] & ~series[\"is_smoke\"].shift(1).fillna(False)).cumsum()\n",
        "episodes = (\n",
        "    series[series[\"is_smoke\"]]\n",
        "    .groupby(\"episode_id\", as_index=False)\n",
        "    .agg(start=(\"date\", \"min\"), end=(\"date\", \"max\"), peak=(\"pm25\", \"max\"), days=(\"date\", \"count\"))\n",
        ")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9, 4))\n",
        "ax.plot(series[\"date\"], series[\"pm25\"], color=\"#4e8ac4\", lw=1.4, label=\"PM2.5 (daily)\")\n",
        "ax.axhline(SMOKE_THRESHOLD, color=\"#c44e4e\", lw=1.2, ls=\"--\", label=f\"Smoke threshold ({SMOKE_THRESHOLD:g})\")\n",
        "\n",
        "for _, e in episodes.iterrows():\n",
        "    ax.axvspan(e[\"start\"], e[\"end\"] + pd.Timedelta(days=1), color=\"#c44e4e\", alpha=0.12)\n",
        "\n",
        "ax.set_title(f\"{station_name} — daily PM2.5 ({series_source})\", fontsize=11)\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"PM2.5 (µg/m³)\")\n",
        "ax.grid(True, alpha=0.25)\n",
        "ax.legend(fontsize=9, loc=\"upper right\")\n",
        "fig.tight_layout()"
      ],
      "id": "fig-smoke-timeseries",
      "execution_count": null,
      "outputs": []
    },
