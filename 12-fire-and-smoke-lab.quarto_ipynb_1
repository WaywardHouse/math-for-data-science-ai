        "## Episode summaries (a first “event lens”)\n",
        "\n",
        "Event-structure visuals make the later evaluation story easier to tell. A first\n",
        "step is to summarise how many smoke days occur in each month, and how peaks\n",
        "cluster."
      ],
      "id": "eeac9646"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| label: fig-smoke-episode-summary\n",
        "#| fig-cap: 'Two quick event summaries: smoke days per month (threshold-based), and a histogram of episode durations. These reveal seasonality and whether events are mostly brief spikes or multi-day episodes.'\n",
        "\n",
        "tmp = series.copy()\n",
        "tmp[\"month\"] = tmp[\"date\"].dt.to_period(\"M\").dt.to_timestamp()\n",
        "\n",
        "smoke_days_per_month = (\n",
        "    tmp.assign(is_smoke=tmp[\"pm25\"] >= SMOKE_THRESHOLD)\n",
        "    .groupby(\"month\", as_index=False)\n",
        "    .agg(smoke_days=(\"is_smoke\", \"sum\"), mean_pm25=(\"pm25\", \"mean\"), peak_pm25=(\"pm25\", \"max\"))\n",
        ")\n",
        "\n",
        "durations = episodes[\"days\"].to_numpy() if len(episodes) else np.array([0])\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
        "\n",
        "ax = axes[0]\n",
        "ax.bar(smoke_days_per_month[\"month\"], smoke_days_per_month[\"smoke_days\"], width=20, color=\"#c44e4e\", alpha=0.75)\n",
        "ax.set_title(\"Smoke days per month\", fontsize=10)\n",
        "ax.set_ylabel(\"Days ≥ threshold\")\n",
        "ax.grid(True, axis=\"y\", alpha=0.25)\n",
        "\n",
        "ax2 = axes[1]\n",
        "bins = np.arange(0.5, max(3.5, durations.max() + 1.5), 1.0)\n",
        "ax2.hist(durations[durations > 0], bins=bins, color=\"#4e8ac4\", alpha=0.8, edgecolor=\"white\")\n",
        "ax2.set_title(\"Episode durations\", fontsize=10)\n",
        "ax2.set_xlabel(\"Days in episode\")\n",
        "ax2.set_ylabel(\"Count\")\n",
        "ax2.grid(True, axis=\"y\", alpha=0.25)\n",
        "\n",
        "fig.tight_layout()"
      ],
